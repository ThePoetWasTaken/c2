PROJECT_DIR := $(shell pwd)

WARNINGS := -march=mips32 -mfp32 -nostdlib -static -Wl,--gc-sections -s
INCLUDE := -I$(PROJECT_DIR)/include -I$(PROJECT_DIR)/../include

DEBUG_FLAGS := -ggdb3 -O0
RELEASE_FLAGS := -Os -ffunction-sections -fdata-sections

SRC := $(wildcard src/*.c) $(wildcard src/*.S)
OBJ := $(patsubst src/%.c,build/%.o,$(SRC))

TARGET := build/preamp

.PHONY: all debug release clean

all: release

run: release
	@clear
	./$(TARGET)

debug: clean
debug: CFLAGS := $(WARNINGS) $(DEBUG_FLAGS) $(INCLUDE)
debug: LDFLAGS :=
debug: $(TARGET)

release: clean
release: CFLAGS := $(WARNINGS) $(RELEASE_FLAGS) $(INCLUDE)
release: LDFLAGS :=
release: $(TARGET)

$(TARGET): $(OBJ)
	@mkdir -p build
	$(CC) $(CFLAGS) $(OBJ) -o $@ $(LDFLAGS)

build/%.o: src/%.c
	@mkdir -p build
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -rf build